(defun P6 ()
  (let ((L nil))
    (format t "Ingrese lista: ")
    (setq L (read))
    (if (listp L)
        (mapcar (lambda (x) 
                  (cond 
                    ((not (numberp x)) nil)
                    ((> x 0) (list x '> 0))
                    ((< x 0) (list x '< 0))
                    (t (list x '= 0))))
        L)
        (pprint "error")
    )))